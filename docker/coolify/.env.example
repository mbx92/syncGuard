# SyncGuard Hub — environment untuk Coolify / docker compose
# Salin ke .env lokal: cp docker/coolify/.env.example docker/coolify/.env
# Di Coolify: paste nilai ini ke Environment Variables resource.

# Wajib — token login dashboard Hub (gunakan string acak yang kuat)
HUB_ADMIN_TOKEN=ganti-dengan-token-kuat-minimal-32-karakter

# Disarankan — URL publik yang bisa diakses agent (HTTPS via proxy Coolify)
HUB_PUBLIC_URL=https://hub.domain.com

# Port aplikasi di dalam container (sesuaikan dengan port mapping Coolify)
PORT=7443
HUB_PORT=7443

# Direktori data persistent (wajib mount volume Coolify ke path ini)
HUB_DATA_DIR=/data
