{
  "name": "syncguard",
  "version": "1.0.0",
  "description": "NAS Backup Manager — rsync to Synology",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "hub": "node hub/server.js",
    "hub:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-port.ps1 -Port 7443 -Quiet",
    "hub:install": "cd hub/web && npm install",
    "hub:build": "cd hub/web && npm run build",
    "hub:dev": "cd hub/web && npm run dev",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:installer:ver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Version $env:npm_config_version"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
